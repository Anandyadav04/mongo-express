<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>weChat | chats </title>
    <style>
        .body {
            background-color: azure;
        }
        .chat {
            border: 2px solid black;
            border-radius: 10px;
            margin: 10px;
            padding: 10px 20px;
            background-color: rgb(242, 231, 217);
            display: inline-block;
        }
        #msg {
            background-color: rgb(173, 233, 213);
            padding: 10px;
            border-radius: 7px;
        }
    </style>
</head>
<body class="body">
     <h1>All Chats</h1>
     <a href="/chats/new" type="btn">New chat</a> <br>
    <% for (let chat of chats) { %>
        <div class="chat">
            <h2>From: <%= chat.from  %></h2>
            <h2 id="msg">Message: <%= chat.msg %> <br><a href="/chats/<%= chat._id %>/edit">Edit</a></h2>
            <h2>Received by: <%= chat.to %> </h2>
            <h2>Created at: <%= chat.created_at.toString().split(" ")[4] %></h2>
            <h2><%= chat.created_at.toString().split(" ").slice(0, 4).join("-") %></h2>
        </div>
    <% } %>
</body>
</html>