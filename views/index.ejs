<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>weChat | chats </title>
    <style>
        .body {
            background-color: azure;
        }
        .chat {
            border: 2px solid black;
            border-radius: 10px;
            margin: 5px;
            padding: 10px 20px;
            background-color: antiquewhite;
            display: inline-block;
        }
    </style>
</head>
<body class="body">
     <h1>All Chats</h1>
     <a href="/chats/new" type="btn">New chat</a> <br>
    <% for (let chat of chats) { %>
        <div class="chat">
            <h2>From: <%= chat.from  %></h2>
            <h2>Message: <%= chat.msg %></h2>
            <h2>Received by: <%= chat.to %></h2>
        </div>
    <% } %>
</body>
</html>