<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>weChat | edit</title>
</head>
<body>
    <h1>Edit the Chat <%= chat._id %></h1>
    <p>From: <%= chat.from %></p>
    <p>To: <%= chat.to %></p>
    <form method="post" action="/chats/<%= chat._id %>?_method=PATCH">
        <label for="msg">Message: </label>
        <textarea name="msg" rows="5" cols="30"><%= chat.msg %> </textarea> <br><br>
        <button type="submit">Update Message</button>
    </form>
</body>
</html>