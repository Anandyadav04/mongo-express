<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>weChat | New</title>
</head>
<body>
    <h1>Create new Chat</h1>
    <form method="post" action="/chats">
        <label for="from">From: </label>
        <input type="text" name="from" placeholder="sender's name"> <br> <br>
        <label for="to">To: </label>
        <input type="text" name="to" placeholder="receiver's name"> <br> <br>
        <label for="msg">Message: </label>
        <textarea name="msg" placeholder="type message here!"></textarea>  <br><br>
        <button>Submit</button>
    </form>
</html>